<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup=false no longer covers device-to-device transfer.
     Exclude everything from both, so the stored refresh token never leaves
     this phone - a new phone signs in fresh. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
