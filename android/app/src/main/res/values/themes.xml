<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so there's no white flash before Compose draws. -->
    <style name="Theme.LightNVR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nvr_background</item>
    </style>

    <!-- One of the widget's mode buttons (the current one gets a bright background in code). -->
    <style name="WidgetModeButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
